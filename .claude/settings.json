{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "forge hook pr-guard",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "forge doctor --harness",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "forge inbox --unread --hook",
            "type": "command"
          }
        ]
      }
    ]
  }
}
